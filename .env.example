# Session signing (required in production)
AUTH_SECRET="change-me-to-a-long-random-string"
# Optional alias (same value as AUTH_SECRET)
NEXTAUTH_SECRET=""

# Public site URL (set to your Vercel production URL after deploy)
APP_URL="http://localhost:3000"
NEXTAUTH_URL=""

# Optional absolute path to Summary.xlsx for local 1-click sync.
EXCEL_PATH=""

# Not required: this app uses hardcoded login + browser Excel upload (no Postgres).
# DATABASE_URL=""
