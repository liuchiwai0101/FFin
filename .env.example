# Session signing (required in production)
AUTH_SECRET="change-me-to-a-long-random-string"
# Optional alias (same value as AUTH_SECRET)
NEXTAUTH_SECRET=""

# Public site URL
APP_URL="http://localhost:3000"
NEXTAUTH_URL=""

# Username -> password JSON. Never commit real values. Required for login.
# Example: {"Vin":"your-password","MA":"your-password","Miki":"your-password","BABA":"your-password"}
FFIN_PASSWORDS=""

# Optional absolute path to Summary.xlsx for local 1-click sync.
EXCEL_PATH=""

# Not required: this app uses login env + browser Excel upload (no Postgres).
# DATABASE_URL=""
